{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/scan/:code", "destination": "/scan/index.html" }
  ],
  "headers": [
    {
      "source": "/scan/twilio.min.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/legal/screenshots/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
